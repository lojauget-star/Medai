{
  "entities": {
    "Patient": {
      "title": "Paciente",
      "description": "Dados cadastrais do animal",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "species": { "type": "string" },
        "breed": { "type": "string" },
        "age": { "type": "string" },
        "ownerId": { "type": "string" }
      },
      "required": ["name", "species", "ownerId"]
    },
    "Report": {
      "title": "Laudo/Prontuário",
      "description": "Laudo gerado pela IA",
      "type": "object",
      "properties": {
        "patientId": { "type": "string" },
        "anamnesis": { "type": "string" },
        "examData": { "type": "string" },
        "soapContent": { "type": "string" },
        "sources": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string", "format": "date-time" },
        "ownerId": { "type": "string" },
        "status": { "type": "string", "enum": ["draft", "finalized"] },
        "rating": { "type": "integer" },
        "feedbackComment": { "type": "string" }
      },
      "required": ["patientId", "soapContent", "ownerId"]
    },
    "Generation": {
      "title": "Post de Marketing",
      "description": "Conteúdo gerado para redes sociais e marketing",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "brandProfile": { "type": "object" },
        "clinicalData": { "type": "object" },
        "carousel": { "type": "array" },
        "instagramCaption": { "type": "string" },
        "linkedinText": { "type": "string" },
        "letterText": { "type": "string" }
      },
      "required": ["ownerId", "createdAt", "carousel"]
    }
  },
  "firestore": {
    "/patients/{patientId}": {
      "schema": "Patient",
      "description": "Documentos dos pacientes"
    },
    "/reports/{reportId}": {
      "schema": "Report",
      "description": "Registros de consultas e laudos"
    },
    "/generations/{generationId}": {
      "schema": "Generation",
      "description": "Banco de dados de postagens e material de marketing gerados"
    }
  }
}
