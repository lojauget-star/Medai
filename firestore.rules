rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Global Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return request.auth != null && 'email' in request.auth.token && request.auth.token.email == 'lojauget@gmail.com';
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // 3. Entity Validations
    function isValidReport(data) {
      return data.keys().hasAll(['patientId', 'soapContent', 'ownerId', 'createdAt', 'status']) &&
             data.patientId is string &&
             data.soapContent is string &&
             data.ownerId == request.auth.uid &&
             data.status in ['draft', 'finalized'];
    }

    function isValidPatient(data) {
      return data.keys().hasAll(['name', 'species', 'ownerId']) &&
             data.name is string &&
             data.species is string &&
             data.ownerId == request.auth.uid;
    }

    function isValidAppointment(data) {
      return data.keys().hasAll(['patientName', 'ownerName', 'type', 'time', 'date', 'ownerId']) &&
             data.patientName is string &&
             data.ownerName is string &&
             data.type is string &&
             data.time is string &&
             data.date is string &&
             data.ownerId == request.auth.uid;
    }

    function isValidPrescription(data) {
      return data.keys().hasAll(['patientName', 'patientSpecies', 'content', 'ownerId']) &&
             data.patientName is string &&
             data.patientSpecies is string &&
             data.content is string &&
             data.ownerId == request.auth.uid;
    }

    // 4. Matches
    match /users/{userId} {
      allow read, write: if request.auth != null;
    }

    match /guidelines/{guidelineId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /reports/{reportId} {
      allow read: if isOwner(resource.data.ownerId) || isAdmin();
      
      allow create: if isSignedIn() && 
                      isValidId(reportId) && 
                      isValidReport(incoming());
      
      allow update: if isOwner(existing().ownerId) && 
                      isValidReport(incoming()) &&
                      incoming().ownerId == existing().ownerId;
                      
      allow delete: if isOwner(existing().ownerId);
    }

    match /generations/{generationId} {
      allow read, delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() && 
                      generationId is string && generationId.size() <= 128 &&
                      incoming().ownerId == request.auth.uid &&
                      incoming().createdAt == request.time;
      allow update: if isSignedIn() && 
                      resource.data.ownerId == request.auth.uid && 
                      incoming().ownerId == resource.data.ownerId &&
                      incoming().createdAt == resource.data.createdAt;
    }

    match /patients/{patientId} {
      allow read: if request.auth != null && resource.data.ownerId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }

    match /appointments/{appointmentId} {
      allow read: if request.auth != null && resource.data.ownerId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }

    match /prescriptions/{prescriptionId} {
      allow read, delete: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && 
                      isValidId(prescriptionId) && 
                      isValidPrescription(incoming()) && 
                      incoming().createdAt == request.time;
      allow update: if isSignedIn() && 
                      resource.data.ownerId == request.auth.uid && 
                      incoming().ownerId == resource.data.ownerId &&
                      isValidPrescription(incoming());
    }
  }
}
