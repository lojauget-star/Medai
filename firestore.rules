rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Global Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // 3. Entity Validations
    function isValidReport(data) {
      return data.keys().hasAll(['patientId', 'soapContent', 'ownerId', 'createdAt', 'status']) &&
             data.patientId is string && data.patientId.size() <= 100 &&
             data.soapContent is string && data.soapContent.size() <= 50000 &&
             data.ownerId == request.auth.uid &&
             data.status in ['draft', 'finalized'] &&
             (data.anamnesis == null || (data.anamnesis is string && data.anamnesis.size() <= 5000)) &&
             (data.examData == null || (data.examData is string && data.examData.size() <= 5000)) &&
             (!('rating' in data) || (data.rating is int && data.rating >= 1 && data.rating <= 5)) &&
             (!('feedbackComment' in data) || (data.feedbackComment is string && data.feedbackComment.size() <= 10000));
    }

    function isValidPatient(data) {
      return data.keys().hasAll(['name', 'species', 'ownerId']) &&
             data.name is string && data.name.size() <= 100 &&
             data.species is string && data.species.size() <= 100 &&
             data.ownerId == request.auth.uid;
    }

    function isValidAppointment(data) {
      return data.keys().hasAll(['patientName', 'ownerName', 'type', 'time', 'date', 'ownerId']) &&
             data.patientName is string && data.patientName.size() <= 100 &&
             data.ownerName is string && data.ownerName.size() <= 100 &&
             data.type is string && data.type.size() <= 50 &&
             data.time is string && data.time.size() <= 10 &&
             data.date is string && data.date.size() <= 20 &&
             data.ownerId == request.auth.uid;
    }

    function isValidPrescription(data) {
      return data.keys().hasAll(['patientName', 'patientSpecies', 'content', 'ownerId']) &&
             data.patientName is string && data.patientName.size() <= 100 &&
             data.patientSpecies is string && data.patientSpecies.size() <= 100 &&
             data.content is string && data.content.size() <= 100000 &&
             data.ownerId == request.auth.uid &&
             (!('patientBreed' in data) || (data.patientBreed is string && data.patientBreed.size() <= 100)) &&
             (!('patientAge' in data) || (data.patientAge is string && data.patientAge.size() <= 100)) &&
             (!('patientSex' in data) || (data.patientSex is string && data.patientSex.size() <= 100)) &&
             (!('patientWeight' in data) || (data.patientWeight is string && data.patientWeight.size() <= 100)) &&
             (!('tutorName' in data) || (data.tutorName is string && data.tutorName.size() <= 100)) &&
             (!('tutorPhone' in data) || (data.tutorPhone is string && data.tutorPhone.size() <= 100)) &&
             (!('clinicalNotes' in data) || (data.clinicalNotes is string && data.clinicalNotes.size() <= 100000)) &&
             (!('routeOfAdmin' in data) || (data.routeOfAdmin is string && data.routeOfAdmin.size() <= 100)) &&
             (!('tutorMessage' in data) || (data.tutorMessage is string && data.tutorMessage.size() <= 100000));
    }

    // 4. Matches
    match /users/{userId} {
      allow read, write: if request.auth != null && (request.auth.uid == userId || request.auth.token.email == 'lojauget@gmail.com');
    }

    match /guidelines/{guidelineId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.token.email == 'lojauget@gmail.com';
    }

    match /reports/{reportId} {
      allow get: if isOwner(existing().ownerId) || (isSignedIn() && request.auth.token.email == 'lojauget@gmail.com');
      allow list: if isSignedIn() && (resource.data.ownerId == request.auth.uid || request.auth.token.email == 'lojauget@gmail.com');
      
      allow create: if isSignedIn() && 
                      isValidId(reportId) && 
                      isValidReport(incoming()) && 
                      incoming().createdAt == request.time;
      
      allow update: if isOwner(existing().ownerId) && 
                      isValidReport(incoming()) &&
                      incoming().ownerId == existing().ownerId &&
                      incoming().createdAt == existing().createdAt &&
                      // Basic Action pattern: any field change is allowed if schema passes,
                      // but typically we'd restrict more. Here we allow content/status updates.
                      incoming().diff(existing()).affectedKeys().hasOnly(['soapContent', 'status', 'anamnesis', 'examData', 'sources', 'patientId', 'rating', 'feedbackComment']);
                      
      allow delete: if isOwner(existing().ownerId);
    }

    match /generations/{generationId} {
      allow get, delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() && 
                      generationId is string && generationId.size() <= 128 &&
                      incoming().ownerId == request.auth.uid &&
                      incoming().createdAt == request.time;
      allow update: if isSignedIn() && 
                      resource.data.ownerId == request.auth.uid && 
                      incoming().ownerId == resource.data.ownerId &&
                      incoming().createdAt == resource.data.createdAt;
    }

    match /patients/{patientId} {
      allow read: if isSignedIn() && (resource == null || resource.data.ownerId == request.auth.uid);
      allow write: if isSignedIn() && (request.resource == null || request.resource.data.ownerId == request.auth.uid) && (resource == null || resource.data.ownerId == request.auth.uid);
    }

    match /appointments/{appointmentId} {
      allow read: if isSignedIn() && (resource == null || resource.data.ownerId == request.auth.uid || request.auth.token.email == 'lojauget@gmail.com');
      allow write: if isSignedIn() && (request.resource == null || request.resource.data.ownerId == request.auth.uid) && (resource == null || resource.data.ownerId == request.auth.uid);
    }

    match /prescriptions/{prescriptionId} {
      allow get, delete: if isSignedIn() && (resource.data.ownerId == request.auth.uid || request.auth.token.email == 'lojauget@gmail.com');
      allow list: if isSignedIn() && (resource.data.ownerId == request.auth.uid || request.auth.token.email == 'lojauget@gmail.com');
      allow create: if isSignedIn() && 
                      isValidId(prescriptionId) && 
                      isValidPrescription(incoming()) && 
                      incoming().createdAt == request.time;
      allow update: if isSignedIn() && 
                      resource.data.ownerId == request.auth.uid && 
                      incoming().ownerId == resource.data.ownerId &&
                      incoming().createdAt == resource.data.createdAt &&
                      isValidPrescription(incoming()) &&
                      incoming().diff(existing()).affectedKeys().hasOnly(['patientName', 'patientSpecies', 'patientBreed', 'patientAge', 'patientSex', 'patientWeight', 'tutorName', 'tutorPhone', 'clinicalNotes', 'routeOfAdmin', 'content', 'tutorMessage']);
    }
  }
}
